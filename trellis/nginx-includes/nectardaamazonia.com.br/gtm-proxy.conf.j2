# 1. Native Bedrock Theme Path + Scope Elevation Header
location ^~ /app/themes/nectartema/public/partytown/ {
    add_header Service-Worker-Allowed "/" always;
    add_header Access-Control-Allow-Origin "*" always;
}

# 2. Google Tag Manager Proxy
location ^~ /gtm-proxy/ {
    proxy_pass https://www.googletagmanager.com/;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host www.googletagmanager.com;

    proxy_ssl_server_name on;
    proxy_ssl_name www.googletagmanager.com;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_hide_header Access-Control-Allow-Origin;
    add_header 'Access-Control-Allow-Origin' '*' always;
}

# 3. Google Analytics Proxy (GA4)
location ^~ /ga-proxy/ {
    proxy_pass https://www.google-analytics.com/;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host www.google-analytics.com;

    proxy_ssl_server_name on;
