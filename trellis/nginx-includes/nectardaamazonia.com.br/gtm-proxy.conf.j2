# site/nginx-includes/nectardaamazonia.com.br/gtm-proxy.conf.j2

location ^~ /gtm-proxy/ {
    proxy_pass https://www.googletagmanager.com/;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;

    # Crucial header additions for Cloudflare compatibility
    proxy_set_header Host www.googletagmanager.com;
    proxy_redirect off;

    # Force CORS allowance so Partytown's Web Worker can read it
    add_header 'Access-Control-Allow-Origin' '*' always;
    add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
}
